# cp .env.example .env
# Required for M4 (RAGAS eval) and M5 (Enrichment LLM calls)
# Lấy key miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# Optional: đổi model (mặc định gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional — máy ít RAM (<8GB): thay bge-m3 / bge-reranker-v2-m3 bằng model đa ngữ nhỏ
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
